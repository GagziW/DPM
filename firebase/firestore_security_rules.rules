rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USER DATA
    // ============================================================

    match /users/{userId} {
      // PRODUCTION COMPATIBILITY: the iOS App Store build (2.1.9) writes the
      // whole User struct via setData without merge, which strips any fields
      // it doesn't know about (e.g. `flames`, `totalFlamePoints`, …). The
      // earlier field-level update lock caught those strips as a "change" to
      // server-managed fields and denied the write, breaking sign-in for
      // every 2.1.9 user. Until 2.1.9 cycles out of the App Store, update
      // stays permissive.
      //
      // The integrity that lock was protecting still holds where it matters:
      //   - The leaderboard is computed from `flameEvents` (server-only).
      //   - Voucher redemptions are audited in `voucherCodes` (server-only).
      //   - Stripe-managed subscription fields are overwritten by the next
      //     webhook event (admin SDK, also rules-bypassing).
      // So a tampered client can only briefly forge values in its OWN user
      // doc — annoying, not catastrophic.
      allow read: if request.auth != null;
      // Account hold is server-owned, even while legacy user writes stay permissive.
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['accountHold']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountHold'])
        && (!resource.data.keys().hasAny(['accountHold'])
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'activeChallenge', 'lastActiveChallengeId', 'currentStreak', 'longestStreak',
            'totalActiveDays', 'totalReps', 'allCompletedDates', 'lastWorkoutDate',
            'lastStreakKeepAliveDate', 'game', 'timezone'
          ]));
      allow delete: if request.auth != null && request.auth.uid == userId
        && !resource.data.keys().hasAny(['accountHold']);

      // Lottery subcollection — scoped to the owner. Previously any
      // authenticated user could read/write ANY other user's lottery docs
      // (no uid check); a user only ever touches their own lottery data.
      match /lottery/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Live Activity push plumbing: ActivityKit tokens + the deadline
      // schedule doc read by the `liveActivityDeadlineSweep` function.
      // Device push tokens are credentials for this user's Lock Screen —
      // strictly owner-scoped. Cloud functions read them via the Admin SDK
      // (rules-bypassing). The fields the sweep's collectionGroup query
      // consumes are type-pinned; everything else is owner-trusted (a forged
      // doc only ever pushes to the owner's own devices).
      match /liveActivities/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (!('kind' in request.resource.data) || request.resource.data.kind is string)
          && (!('nextDeadlineAt' in request.resource.data) || request.resource.data.nextDeadlineAt is timestamp)
          && (!('token' in request.resource.data) || request.resource.data.token is string)
          && (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string);
      }
    }

    // ============================================================
    // CHALLENGES (Personal Records)
    // ============================================================

    // Reads stay open to signed-in users: group teammates render each other's
    // challenge docs by raw ID (GroupChallengeService.getParticipantChallenge
    // fetches other participants' challenges for flexible-reps targets), so
    // reads can't be owner-scoped. Writes ARE owner-scoped — every client
    // create path (iOS SocialChallengeBuilder, DPM.org createChallenge, Android
    // FirestoreChallengeRepository) stamps userId with the signed-in uid, and
    // every update/delete targets the caller's own doc. Update checks BOTH
    // sides so a user can neither modify someone else's challenge nor
    // re-own a doc by stamping their own uid into it. Admin tooling
    // (admin-board, admin-cli, cloud functions) uses the Admin SDK
    // and bypasses these rules.
    function accountIsOnHold(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.keys().hasAny(['accountHold']);
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && !accountIsOnHold(request.auth.uid);
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && !accountIsOnHold(request.auth.uid)
        // Released clients resolve competition misses locally before the
        // hourly Admin-SDK backstop. Never let a client make cooldown
        // irreversible while the authoritative live document still has a
        // Life available; the server resolver consumes coverage first and
        // bypasses rules when failure is genuinely due.
        && !(resource.data.get('competitionId', '') != ''
          && resource.data.get('status', '') == 'active'
          && resource.data.get('remainingSkipDays', 0) > 0
          && (request.resource.data.get('status', '') == 'cooldown'
            || request.resource.data.get('status', '') == 'failed'));
      // Admins (staff Group Dashboard cleanup) may delete any challenge.
      allow delete: if request.auth != null
        && ((resource.data.userId == request.auth.uid && !accountIsOnHold(request.auth.uid)) || isCompetitionAdmin());
    }

    // ============================================================
    // PAYMENTS
    // ============================================================

    match /payments/{paymentId} {
      // Users can create payments for themselves
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.get('challengeId', '') in ['', null]
          || (request.resource.data.challengeId is string
            && getAfter(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.userId == request.auth.uid));
      allow read: if request.auth != null;
      // Clients legitimately update only `status` / `challengeId`
      // (PaymentService.updatePaymentStatus / linkPaymentToChallenge) — never
      // `amount`. Require `amount` to be present AND unchanged on every update
      // so a user can neither lower NOR delete an authorized stake before the
      // admin-board off-session capture charges it (deleting it would make the
      // capture read NaN and skip the charge). updateData is a merge, so a legit
      // status/challengeId update keeps `amount` present and equal; every
      // payment doc is created with a non-optional amount.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    // First link is client-authored after challenge creation;
                    // an established monetary commitment cannot be relinked.
                    && (request.resource.data.get('challengeId', null) == resource.data.get('challengeId', null)
                      || (resource.data.get('challengeId', '') in ['', null]
                        && request.resource.data.challengeId is string
                        && getAfter(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.userId == request.auth.uid))
                    && ('amount' in request.resource.data)
                    && ('amount' in resource.data)
                    && request.resource.data.amount == resource.data.amount;
    }

    // ============================================================
    // WORKOUT SESSIONS
    // ============================================================

    // No current client touches this collection (iOS's WorkoutSessionManager
    // is in-app state; the per-day counters live on users/{uid}.
    // workoutSessionsByDay). Only the admin-cli deletes these docs,
    // via the Admin SDK. Fully owner-scoped — reads included — so any legacy
    // build that still queries its own sessions (filtered by userId) keeps
    // working while cross-user access is closed.
    match /workoutSessions/{sessionId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Workout Credit is an Admin-SDK-only write model. Clients receive their
    // receipt through callables and never read or mutate these collections
    // directly, which keeps idempotency and effect status authoritative.
    match /workoutCredits/{creditId} {
      allow read, write: if false;
    }
    match /workoutCreditEffects/{effectId} {
      allow read, write: if false;
    }
    match /duelSkipClaims/{claimId} {
      allow read, write: if false;
    }
    match /workoutCreditCleanupJobs/{jobId} {
      allow read, write: if false;
    }
    match /workoutCreditStatShards/{shardId} {
      allow read, write: if false;
    }
    match /workoutCreditMiningDays/{dayId} {
      allow read, write: if false;
    }
    match /workoutCreditBadgeInputs/{inputId} {
      allow read, write: if false;
    }
    match /workoutCreditMultiplayerInputs/{inputId} {
      allow read, write: if false;
    }
    match /workoutCreditNotificationInputs/{inputId} {
      allow read, write: if false;
    }

    // ============================================================
    // GROUP CHALLENGES (Multiplayer 2-10 people)
    // ============================================================

    // Group hardening (mirrors the competitions pattern). Reads stay open —
    // the invite-code lookup runs before membership, and teammates render each
    // other's docs, so query rules can't be membership-scoped. Updates stay
    // open to any signed-in user because joins and progress syncs are
    // whole-roster transactional rewrites from clients (accepted residual
    // risk, same as competitions), but the group's identity and economic
    // template are pinned and deletion is restricted.
    function isGroupCreatorOrSoleParticipant(data) {
      return request.auth.uid == data.createdBy
        || (data.participants.size() == 1 && data.participants[0].id == request.auth.uid);
    }
    function parentGroupData(groupId) {
      return get(/databases/$(database)/documents/challengeGroups/$(groupId)).data;
    }

    match /challengeGroups/{groupId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.startDate is timestamp
        && request.resource.data.endDate is timestamp
        && request.resource.data.stakeAmount is number
        && request.resource.data.stakeAmount >= 0;

      // Live client writes (join, roster sync, workout counter) only touch
      // participants/totalMoneyStaked/totalWorkoutsCompleted, so these pins
      // cost nothing legitimate. isActive is server-owned (daily cleanup via
      // Admin SDK); pinning it stops clients resurrecting or hiding groups.
      // Timestamps compared at 1s tolerance: iOS round-trips
      // Timestamp → Date → Timestamp, which can drift by microseconds.
      allow update: if request.auth != null
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.isActive == resource.data.isActive
        && math.abs(request.resource.data.startDate.toMillis() - resource.data.startDate.toMillis()) < 1000
        && math.abs(request.resource.data.endDate.toMillis() - resource.data.endDate.toMillis()) < 1000
        && request.resource.data.stakeAmount == resource.data.stakeAmount
        && request.resource.data.get('mode', '') == resource.data.get('mode', '')
        && request.resource.data.get('durationDays', 0) == resource.data.get('durationDays', 0)
        && request.resource.data.get('startCalendarDateKey', '') == resource.data.get('startCalendarDateKey', '');

      // Creator deletes (create-flow rollback), or the sole remaining roster
      // entry (convert-to-solo / last-failure cleanup: the iOS manager prunes
      // expired/failed teammate rows before deleting, so the caller is the
      // only entry left). Honest caveat: with the update rule open for
      // whole-roster rewrites, a determined client can always rewrite the
      // roster to itself and then delete — this clause guards against
      // accidents, not a dedicated attacker (same accepted residual risk as
      // competitions). Admins may also delete (staff Group Dashboard cleanup).
      allow delete: if request.auth != null
        && (isGroupCreatorOrSoleParticipant(resource.data) || isCompetitionAdmin());
    }

    // Per-day completion records. Writes are owner-scoped — every iOS write
    // path (updateProgress, backfillProgressDocs) touches only the signed-in
    // user's docs. Delete additionally allows the group's creator / sole
    // participant: deleteGroup batch-purges every participant's progress docs
    // (rules `get()` sees the pre-batch group doc even when the same batch
    // deletes it). Owner check first so the common case skips the get().
    match /groupProgress/{progressId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || isGroupCreatorOrSoleParticipant(parentGroupData(resource.data.groupId)));
    }

    // In-progress HealthKit values for group running/steps previews.
    // Official completion remains in groupProgress. Owner-scoped writes —
    // update checks BOTH sides so a teammate can't take over an existing doc
    // (ids are predictable: groupId_userId_dayNumber) by stamping their own
    // uid into it.
    match /groupLiveProgress/{progressId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // COMPETITIONS (Large-scale 10–10,000 people) — schema v2
    // ============================================================

    // Rosters live in `teams/` + `members/` subcollections and all roster /
    // score mutations flow through callable Cloud Functions. Keeping these
    // subcollections explicit is both the 10k scaling boundary and the client
    // authorization boundary: a missing nested match denies every roster read.

    // Admin allowlist gate (bonus-carrying creations, staff cleanup deletes).
    function isCompetitionAdmin() {
      return request.auth.uid in get(/databases/$(database)/documents/config/admins).data.adminUids;
    }

    // Shared staff registry used by the iOS staff surfaces and cloud sweeps.
    match /config/staff {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.staffUids;
      allow write: if false;
    }

    match /competitions/{competitionId} {
      allow read: if request.auth != null;

      // Open create (product decision 2026-06-12: competitions are a normal
      // user feature, same as groups) — EXCEPT the economic field.
      // winnerBonusDpm drives the server-side DPM payout at settlement
      // (`cleanupStaleSocialChallenges`), so an open bonus would let anyone
      // mint DPM via a self-winning, short-lived competition. Bonus-carrying
      // competitions stay admin-only via config/admins; everyone else creates
      // with bonus 0/absent. The || short-circuits, so normal creations never
      // read config/admins (no seed required for them). v2 roots must never
      // carry the old embedded roster arrays.
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.startDate is timestamp
        && request.resource.data.endDate is timestamp
        && request.resource.data.endDate.toMillis() > request.resource.data.startDate.toMillis()
        && request.resource.data.get('winnerBonusDpm', 0) is int
        && (request.resource.data.get('winnerBonusDpm', 0) == 0 || isCompetitionAdmin())
        && request.resource.data.schemaVersion == 2
        && !('teams' in request.resource.data)
        && !('participants' in request.resource.data);

      // All roster/score mutation is server-owned. The creator may only polish
      // presentation/config before start; identity, economics, contest shape,
      // lifecycle, settlement, and aggregates are pinned.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy
        && (resource.data.get('status', '') == 'scheduled'
            || request.time < resource.data.startDate)
        && !('settledAt' in resource.data)
        && !('settledAt' in request.resource.data)
        && request.resource.data.get('winningTeamId', null) == null
        && request.resource.data.get('winningTeamName', null) == null
        && !('teams' in request.resource.data)
        && !('participants' in request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && math.abs(request.resource.data.startDate.toMillis() - resource.data.startDate.toMillis()) < 1000
        && math.abs(request.resource.data.endDate.toMillis() - resource.data.endDate.toMillis()) < 1000
        && request.resource.data.stakeAmount == resource.data.stakeAmount
        && request.resource.data.get('winnerBonusDpm', 0) == resource.data.get('winnerBonusDpm', 0)
        && request.resource.data.get('performanceMetric', null) == resource.data.get('performanceMetric', null)
        && request.resource.data.get('targetReps', null) == resource.data.get('targetReps', null)
        && request.resource.data.get('targetDays', null) == resource.data.get('targetDays', null)
        && request.resource.data.get('maxParticipants', null) == resource.data.get('maxParticipants', null)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('participantCount', 0) == resource.data.get('participantCount', 0)
        && request.resource.data.get('teamCount', 0) == resource.data.get('teamCount', 0)
        && request.resource.data.get('totalRepsCompleted', 0) == resource.data.get('totalRepsCompleted', 0)
        && request.resource.data.get('totalWorkoutsCompleted', 0) == resource.data.get('totalWorkoutsCompleted', 0);

      // Only the organizer can delete, and only before settlement — a settled
      // competition is a payout record and stays (archived copy also exists).
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy
        && !('settledAt' in resource.data);

      // Server-owned v2 standings and roster. Authenticated clients may read;
      // writes run only through Admin-SDK callables/aggregators.
      match /teams/{teamId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create, delete: if false;
        allow update: if request.auth != null
          && request.auth.uid == memberId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'avatarEmoji', 'avatarColor']);
      }

      match /counters/{shardId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /pushShards/{shardId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    function competitionProgressBoundsOK() {
      return request.resource.data.dayNumber is int
        && request.resource.data.dayNumber >= 1
        && request.resource.data.dayNumber <= 4000
        && (!('completedReps' in request.resource.data)
            || (request.resource.data.completedReps is int
                && request.resource.data.completedReps >= 0
                && request.resource.data.completedReps <= 50000))
        && (!('requiredReps' in request.resource.data)
            || (request.resource.data.requiredReps is int
                && request.resource.data.requiredReps >= 1));
    }

    // Per-day completion records for competitions — same owner-scoped
    // contract as groupProgress: every iOS write path (post-workout sync,
    // backfillProgressDocs) touches only the signed-in user's docs, and the
    // doc IDs are predictable (competitionId_userId_dayN) so update checks
    // BOTH sides to stop a rival stamping their uid into someone else's day.
    // The server aggregator folds these owner-authored records into member and
    // team aggregates. Canonical IDs and an immutable `agg` stamp prevent one
    // day from being counted twice or redirected after aggregation.
    match /competitionProgress/{progressId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && request.resource.data.userId == request.auth.uid
        && (
             progressId == request.resource.data.competitionId + '_' + request.auth.uid + '_day' + string(request.resource.data.dayNumber)
             ||
             ( request.resource.data.dateKey is string
               && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
               && progressId == request.resource.data.competitionId + '_' + request.auth.uid + '_' + request.resource.data.dateKey )
           )
        && !('agg' in request.resource.data)
        && competitionProgressBoundsOK();
      allow update: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.competitionId == resource.data.competitionId
        && request.resource.data.dayNumber == resource.data.dayNumber
        && request.resource.data.get('dateKey', null) == resource.data.get('dateKey', null)
        && request.resource.data.get('agg', null) == resource.data.get('agg', null)
        && competitionProgressBoundsOK();
      allow delete: if isCompetitionAdmin();
    }

    // In-progress reps for competition live rings — competition analog of
    // groupLiveProgress. Owner-scoped writes; ids are predictable
    // (competitionId_userId_dayNumber) so update checks BOTH sides to stop a
    // rival stamping their uid into someone else's doc.
    function competitionLiveBoundsOK() {
      return request.resource.data.dayNumber is int
        && request.resource.data.dayNumber >= 1
        && request.resource.data.dayNumber <= 4000
        && request.resource.data.currentReps is int
        && request.resource.data.currentReps >= 0
        && request.resource.data.currentReps <= 50000
        && request.resource.data.requiredReps is int
        && request.resource.data.requiredReps >= 1;
    }

    match /competitionLiveProgress/{progressId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && request.resource.data.userId == request.auth.uid
        && progressId == request.resource.data.competitionId + '_' + request.auth.uid + '_' + string(request.resource.data.dayNumber)
        && competitionLiveBoundsOK();
      allow update: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.competitionId == resource.data.competitionId
        && request.resource.data.dayNumber == resource.data.dayNumber
        && competitionLiveBoundsOK();
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Async 1v1 Duels. Creation is deterministically keyed by the creator's
    // physical attempt, so ambiguous retries resolve to the same document.
    // The opponent may submit exactly once; result/economy fields remain
    // server-owned. The creator may only acknowledge a completed reveal.
    match /duels/{duelId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && request.resource.data.creatorId == request.auth.uid
        && (
          !('creatorAttemptId' in request.resource.data)
          || (request.resource.data.creatorAttemptId is string
            && duelId == request.auth.uid + '_' + request.resource.data.creatorAttemptId
            && getAfter(/databases/$(database)/documents/duelInviteCodes/$(request.resource.data.inviteCode)).data.duelId == duelId)
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.creatorScore is int
        && request.resource.data.get('winnerId', null) == null
        && request.resource.data.get('rewardedUserId', null) == null
        && request.resource.data.get('opponentScore', null) == null;

      // Reservation: the first eligible person to open the link takes the
      // Duel. Only their identity + server time land; scores stay absent.
      allow update: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && resource.data.status == 'pending'
        && request.time < resource.data.expiresAt
        && resource.data.creatorId != request.auth.uid
        && resource.data.get('opponentId', null) == null
        && resource.data.get('opponentScore', null) == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['opponentId', 'opponentName', 'opponentAvatarEmoji', 'opponentReservedAt'])
        && request.resource.data.opponentId == request.auth.uid
        && request.resource.data.opponentName is string
        && request.resource.data.opponentName.size() <= 100
        && (!('opponentAvatarEmoji' in request.resource.data)
            || (request.resource.data.opponentAvatarEmoji is string
                && request.resource.data.opponentAvatarEmoji.size() <= 32))
        && request.resource.data.opponentReservedAt == request.time;

      // Submission: only the holder, if the Duel was reserved. Writes only
      // the opponent's attempt — outcome/economy fields stay server-owned
      // (a client-stamped resolvedAt would make onDuelWritten skip settling).
      allow update: if request.auth != null && !accountIsOnHold(request.auth.uid)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'completed'
        && resource.data.creatorId != request.auth.uid
        && (resource.data.get('opponentId', null) == null
            || resource.data.opponentId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['opponentId', 'opponentAttemptId', 'opponentName', 'opponentAvatarEmoji',
                       'opponentScore', 'opponentRepTimeline', 'opponentAttemptAt', 'status'])
        && request.resource.data.opponentId == request.auth.uid
        && request.resource.data.opponentScore is int
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.get('creatorAttemptId', null) == resource.data.get('creatorAttemptId', null)
        && request.resource.data.creatorScore == resource.data.creatorScore
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.workoutType == resource.data.workoutType
        && request.resource.data.durationSeconds == resource.data.durationSeconds
        && request.resource.data.get('winnerId', null) == null
        && request.resource.data.get('rewardedUserId', null) == null
        && request.time < resource.data.expiresAt;

      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creatorResultSeen'])
        && request.resource.data.creatorResultSeen == true;

      allow delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
    }

    match /duelInviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['duelId', 'creatorId', 'createdAt'])
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && getAfter(/databases/$(database)/documents/duels/$(request.resource.data.duelId)).data.creatorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/duels/$(request.resource.data.duelId)).data.inviteCode == code;
      allow update, delete: if false;
    }

    // Admin allowlist for competition creation — server-managed only.
    match /config/admins {
      allow read, write: if false;
    }

    // ============================================================
    // ARCHIVE COLLECTIONS (Completed/Failed challenges storage)
    // ============================================================

    // Archived challenges
    match /archivedChallenges/{archiveId} {
      // TEMPORARY: All operations allowed for authenticated users
      allow create, read: if request.auth != null;
      // Long-offline Workout Credit recovery may need to claim the one-way
      // perfect-completion marker after the live challenge has been archived.
      // No other archived data is mutable by clients.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfectStatsApplied'])
        && request.resource.data.perfectStatsApplied == true
        && resource.data.get('perfectStatsApplied', false) != true;
      // Admins may delete archived copies for staff Group Dashboard cleanup.
      allow delete: if isCompetitionAdmin();
    }

    // Resolved disputes (challengeResolved/{challengeId}) — written exclusively
    // by the admin dispute resolver (Admin SDK: admin-board + admin CLI), which
    // bypasses these rules. Docs carry a top-level `userId` plus the full
    // challenge + dispute snapshot (rebuttal messages, admin reasons), so reads
    // are scoped to the owning user — both iOS (ArchiveService) and Android
    // (FirestoreChallengeRepository) query with `userId == request.auth.uid`.
    match /challengeResolved/{challengeId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false;
    }

    // Archived groups - any authenticated user can archive/read
    // Security: Archives are immutable once created, and contain historical data
    match /archivedChallengeGroups/{archiveId} {
      // Anyone can create archives (triggered when group ends)
      allow create: if request.auth != null;

      // Anyone authenticated can read archives (for viewing historical challenges)
      allow read: if request.auth != null;

      // No updates or deletes - archives are immutable
      allow update, delete: if false;
    }

    // Archived competitions
    match /archivedCompetitions/{archiveId} {
      allow create: if request.auth != null && (
        // Creator can archive
        request.auth.uid == request.resource.data.createdBy ||
        // Allow authenticated users (cloud function also archives)
        true
      );

      // Anyone authenticated can read archived competitions
      allow read: if request.auth != null;

      // No updates or deletes - archives are immutable
      allow update, delete: if false;
    }

    // Archived group progress
    match /archivedGroupProgress/{archiveId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null;

      // No updates or deletes - archives are immutable
      allow update, delete: if false;
    }

    // Archived competition progress (same lifecycle as archivedGroupProgress)
    match /archivedCompetitionProgress/{archiveId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null;

      // No updates or deletes - archives are immutable
      allow update, delete: if false;
    }

    // ============================================================
    // BADGE SYSTEM
    // ============================================================

    // Badge progress (lowercase - matches code)
    match /badgeProgress/{userId} {
      // TEMPORARY: All operations allowed for authenticated users
      allow create, read, update, delete: if request.auth != null;
    }

    // User badges collection
    match /userBadges/{userId} {
      // TEMPORARY: All operations allowed for authenticated users
      allow create, read, update, delete: if request.auth != null;
    }

    // ============================================================
    // FLAMES & SPARKS (Social engagement — server-authoritative)
    //
    // referrals: audit log of spark <-> flame links (written by trigger).
    // sparkDailyDigest: per-spark per-day aggregator for batched push.
    // flameEvents: audit log of credit/link/cap events.
    //
    // All three are written exclusively by Cloud Functions (admin SDK).
    // Clients can only READ rows that pertain to them.
    // ============================================================

    match /referrals/{referralId} {
      allow read: if request.auth != null
                  && (resource.data.sparkId == request.auth.uid
                      || resource.data.flameId == request.auth.uid);
      allow write: if false; // server-only via admin SDK
    }

    match /sparkDailyDigest/{digestId} {
      allow read: if request.auth != null
                  && resource.data.sparkId == request.auth.uid;
      allow write: if false; // server-only
    }

    match /flameEvents/{eventId} {
      allow read: if request.auth != null
                  && (resource.data.sparkId == request.auth.uid
                      || resource.data.flameId == request.auth.uid);
      allow write: if false; // server-only
    }

    // ============================================================
    // GLOBAL DATA (Read-only for clients)
    // ============================================================

    match /globalStats/{docId} {
      // TEMPORARY: Allow read without auth for development
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // `globalStats/userCounter` is the atomic counter used by
    // UserManager.getNextUserNumberAtomic() to assign sequential "UserNNN"
    // names on first sign-in. The transaction reads + writes this single doc
    // directly from the iOS client — without this rule, every new user
    // sign-in fails with PERMISSION_DENIED before the user doc is ever
    // created. The generic globalStats deny above still applies to every
    // other doc in the collection (badgeStats, etc.).
    //
    // FOLLOW-UP: move the counter into a callable Cloud Function so this
    // single client-writable surface goes away.
    match /globalStats/userCounter {
      allow read, write: if request.auth != null;
    }

    match /globalStats/{docId}/{subcollection}/{subDocId} {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    match /leaderboards/{leagueId} {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // ============================================================
    // APP CONFIG (Runtime feature flags — read by FeatureFlags.refresh())
    //
    // `appConfig/features` carries runtime flags (`infiniteGroupsEnabled`,
    // `showDemoLogin` — the App Store reviewer demo login) read at app launch,
    // possibly before auth is established, so it is public-read like
    // globalStats/leaderboards above. The values are non-sensitive booleans.
    // Clients never write; flip values from the Console or Admin SDK.
    // ============================================================

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if false; // Console / Cloud Function only
    }

    // ============================================================
    // VOUCHER CODE STATS (aggregate counters per code)
    // Written exclusively by the redeemVoucherCode Cloud Function via the
    // Admin SDK. Clients must never read this — exposing redemption counts
    // would leak distribution telemetry for an exclusive code.
    // (This rule precedes the catch-all so it is honored.)
    // ============================================================

    match /voucherCodes/{code} {
      allow read, write: if false;
    }

    // ============================================================
    // USER NOTICES (Support / system messages targeted at one user)
    // Created by Cloud Functions; DPM.org lists them filtered by
    // userId == auth.uid. Explicit rule placed before the catch-all so
    // it's still honoured if/when the catch-all is removed.
    // ============================================================

    match /userNotices/{noticeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ============================================================
    // ADMIN AUDIT LOG (Cloud Function only — Apple token revocations, etc.)
    // ============================================================

    match /adminActions/{actionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // server-only
    }

    // ============================================================
    // CHALLENGE DISPUTES (Failed-challenge appeals)
    // ============================================================

    match /challengeDisputes/{challengeId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // ============================================================
    // ANALYTICS EVENTS (funnel instrumentation — append-only)
    //
    // Written fire-and-forget by iOS `AnalyticsService.track` (uid-pinned,
    // stamps `event`/`userId`/`platform`/`appVersion`/`createdAt` + event
    // properties). Create-only: clients can never read, edit, or delete the
    // log — it's read server-side via the Admin SDK only. iOS is the only
    // emitter today; `platform` is validated so web/Android can join later.
    // ============================================================

    match /analyticsEvents/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.event is string
        && request.resource.data.event.size() < 64
        && request.resource.data.platform in ['ios', 'android', 'web'];
      allow read, update, delete: if false; // server-only via Admin SDK
    }

    // ============================================================
    // LIVE ACTIVITY FAN-OUT STATE (server-only)
    // ============================================================
    // Dedup/throttle bookkeeping for Live Activity pushes (last-sent
    // signatures, per-day push-to-start ledgers). Written exclusively by
    // cloud functions via the Admin SDK.

    match /liveActivityState/{stateId} {
      allow read, write: if false;
    }

    // ============================================================
    // (No catch-all — anything not explicitly allowed is denied.)
    // Field-level write restrictions on /users above only take effect when
    // they aren't shadowed by a permissive catch-all rule.
    // ============================================================
  }
}
